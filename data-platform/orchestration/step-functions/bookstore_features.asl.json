{
  "Comment": "Build operational churn scoring and recommendation features sequentially",
  "QueryLanguage": "JSONata",
  "StartAt": "Glue-Churn-Scoring-Features",
  "States": {
    "Glue-Churn-Scoring-Features": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_features_churn_bookstore",
        "Arguments": {
          "--dataset_mode": "scoring",
          "--cutoff_timestamp": "{% $states.input.cutoff_timestamp %}",
          "--data_as_of_timestamp": "{% $states.input.data_as_of_timestamp %}",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Output": "{% $states.input %}",
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 10,
          "BackoffRate": 1.5
        }
      ],
      "Next": "Glue-Recommendation-Features"
    },
    "Glue-Recommendation-Features": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "glue_features_recommendation_bookstore",
        "Arguments": {
          "--cutoff_timestamp": "{% $states.input.cutoff_timestamp %}",
          "--data_as_of_timestamp": "{% $states.input.data_as_of_timestamp %}",
          "--lookback_days": "{% $string($states.input.lookback_days) %}",
          "--run_id": "{% $states.context.Execution.Name %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 10,
          "BackoffRate": 1.5
        }
      ],
      "End": true
    }
  }
}
